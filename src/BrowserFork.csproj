<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- only for the tray icon (NotifyIcon); keep its namespaces out of the global usings to avoid clashes with WPF -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF takes its DPI awareness from app.manifest -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BrowserFork</AssemblyName>
    <RootNamespace>BrowserFork</RootNamespace>
    <StartupObject>BrowserFork.Program</StartupObject>
    <ApplicationIcon>BrowserFork.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Product>BrowserFork</Product>
    <AssemblyTitle>BrowserFork – browser picker</AssemblyTitle>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="BrowserFork.ico" />
    <InternalsVisibleTo Include="BrowserFork.Tests" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>

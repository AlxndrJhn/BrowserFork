<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BrowserFork</AssemblyName>
    <RootNamespace>BrowserFork</RootNamespace>
    <StartupObject>BrowserFork.Program</StartupObject>
    <ApplicationIcon>BrowserFork.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Product>BrowserFork</Product>
    <AssemblyTitle>BrowserFork – browser picker</AssemblyTitle>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="BrowserFork.ico" />
  </ItemGroup>

</Project>

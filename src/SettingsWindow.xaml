<Window x:Class="BrowserFork.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BrowserFork settings" Icon="BrowserFork.ico"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <StackPanel Margin="20,16,20,18">
        <TextBlock x:Name="VersionText" Foreground="#6C6C78" TextWrapping="Wrap" />

        <TextBlock Text="Always open links from" Margin="0,16,0,6" FontSize="14" FontWeight="SemiBold" />
        <TextBlock x:Name="NoRulesText" TextWrapping="Wrap" Foreground="#6C6C78"
                   Text="No apps yet. Tick “Always open links from … this way” in the picker to add one." />
        <ItemsControl x:Name="RuleList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,2">
                        <Button DockPanel.Dock="Right" Content="Remove" Padding="10,2" Click="OnRemoveRule" Tag="{Binding Key}" />
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0">
                            <Run Text="{Binding App, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" → " Foreground="#6C6C78" /><Run Text="{Binding Target, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Margin="0,6,0,0" FontSize="11.5" Foreground="#6C6C78" TextWrapping="Wrap"
                   Text="Hold Shift while clicking a link to get the picker anyway." />

        <TextBlock Text="General" Margin="0,18,0,6" FontSize="14" FontWeight="SemiBold" />
        <CheckBox x:Name="AutostartBox" Content="Show the tray icon when Windows starts" Margin="0,2" />
        <CheckBox x:Name="AutoUpdateBox" Content="Install updates automatically" Margin="0,2" />

        <TextBlock Text="Report a problem" Margin="0,18,0,6" FontSize="14" FontWeight="SemiBold" />
        <CheckBox x:Name="LoggingBox" Content="Keep a log for problem reports" Margin="0,2" />
        <TextBlock TextWrapping="Wrap" Foreground="#6C6C78" Margin="0,4,0,0"
                   Text="Turn this on, then make the problem happen again. The log leaves out links, e-mail addresses, user names and profile names. Turning it off deletes it." />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Save anonymized log…" Padding="12,4" Click="OnSaveLog" />
            <Button Content="Open issues on GitHub" Padding="12,4" Margin="8,0,0,0" Click="OnOpenIssues" />
        </StackPanel>

        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button x:Name="CheckButton" Content="Check for updates" Padding="12,4" Click="OnCheck" />
            <Button Content="Default apps…" Padding="12,4" Margin="8,0,0,0" Click="OnDefaultApps" />
            <Button DockPanel.Dock="Right" Content="Close" Padding="16,4" IsCancel="True" Click="OnClose" />
        </DockPanel>
    </StackPanel>
</Window>

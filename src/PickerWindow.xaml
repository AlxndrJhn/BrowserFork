<Window x:Class="BrowserFork.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BrowserFork" Icon="BrowserFork.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#7AB0FF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F3F6" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9C9CA8" />
        <SolidColorBrush x:Key="TextTertiary" Color="#6C6C78" />

        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="128" Height="156" Margin="5" CornerRadius="10"
                                Background="#0DFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1.5">
                            <Grid>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0"
                                        CornerRadius="4" Background="#14FFFFFF" Padding="5,0,5,1">
                                    <TextBlock Text="{Binding Hotkey}" FontSize="10.5" Foreground="{StaticResource TextTertiary}" />
                                </Border>
                                <StackPanel Margin="8,22,8,0" VerticalAlignment="Top">
                                    <Grid Width="44" Height="44">
                                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock x:Name="GlyphText" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="32" Foreground="{StaticResource TextSecondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" Margin="0,10,0,0" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="ProfileText" Text="{Binding ProfileName}" Margin="0,1,0,0" FontSize="11.5"
                                               Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="NoteText" Text="{Binding Note}" Margin="0,4,0,0" FontSize="10.5"
                                               LineHeight="13" Foreground="{StaticResource Accent}" TextAlignment="Center"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                                <Setter TargetName="NoteText" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ProfileName}" Value="{x:Null}">
                                <Setter TargetName="ProfileText" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Glyph}" Value="{x:Null}">
                                <Setter TargetName="GlyphText" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#267AB0FF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#407AB0FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="26" Height="26" CornerRadius="6" Background="Transparent">
                            <TextBlock x:Name="Tx" Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF" />
                                <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <!-- shadow lives on its own layer so the text stays ClearType-crisp -->
        <Border CornerRadius="14" Background="#1C1C21">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.55" Color="Black" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="14" Background="#1C1C21" BorderBrush="#26FFFFFF" BorderThickness="1"
                MouseLeftButtonDown="OnDragArea">
            <StackPanel Margin="18,12,18,14">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}" Click="OnCancel" ToolTip="Cancel (Esc)" />
                    <Image x:Name="CallerIcon" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="CallerText" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock x:Name="UrlText" Margin="0,8,0,12" FontSize="14" TextTrimming="CharacterEllipsis">
                    <Run x:Name="UrlHost" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" /><Run x:Name="UrlRest" Foreground="{StaticResource TextTertiary}" />
                </TextBlock>

                <WrapPanel x:Name="TilePanel" Orientation="Horizontal" Margin="-5,0" HorizontalAlignment="Left"
                           KeyboardNavigation.DirectionalNavigation="Cycle"
                           KeyboardNavigation.TabNavigation="Cycle" />

                <!-- not focusable, so the keyboard stays on the tiles; Alt+A toggles it -->
                <CheckBox x:Name="AlwaysBox" Margin="0,12,0,0" Focusable="False" FontSize="12"
                          Foreground="{StaticResource TextSecondary}" VerticalContentAlignment="Center"
                          ToolTip="Skip this window for links from this app. Undo it in the tray icon's Settings." />

                <TextBlock x:Name="Hints" Margin="0,12,0,0" FontSize="11" Foreground="{StaticResource TextTertiary}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
